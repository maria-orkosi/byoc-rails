<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Builders</title>
  <link rel="stylesheet" href="/dashboard.css">
</head>
<body class="login-layout">
  <div class="login-box">
    <h1 class="login-heading">Builders</h1>
    <p class="login-subtitle">Sign in to your dashboard</p>

    <% if flash[:alert] %>
      <p class="login-alert"><%= flash[:alert] %></p>
    <% end %>
    <% if flash[:notice] %>
      <p class="login-notice"><%= flash[:notice] %></p>
    <% end %>

    <%= form_tag login_path, method: :get, class: "login-form" do %>
      <label for="user_id" class="login-label">User ID</label>
      <%= number_field_tag :user_id, nil, class: "login-input", placeholder: "Enter your user ID" %>
      <%= submit_tag "Sign in", class: "login-button" %>
    <% end %>

    <p class="login-hint">Development mode: enter any number to sign in.</p>
  </div>
</body>
</html>