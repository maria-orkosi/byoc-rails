<h1 class="text-xl font-bold mb-4">New Project</h1>

<div class="card">
  <%= form_with model: @project || Project.new, url: projects_path, local: true do |f| %>
    <div class="form-group">
      <%= f.label :name, "Project Name", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, class: "form-input", rows: 3 %>
    </div>
    <%= f.submit "Create Project", class: "btn btn-primary" %>
    <%= link_to "Cancel", projects_path, class: "btn btn-secondary" %>
  <% end %>
</div>