<!DOCTYPE html>
<html>
  <head>
    <title>Byoc Rails</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if Rails.application.config.analytics_enabled && Rails.application.config.analytics_key.present? %>
      <script nonce="<%= content_security_policy_nonce %>">
        window.trackingKey = <%= raw ENV["ANALYTICS_KEY"].to_json %>;
        window.trackingEndpoint = <%= raw (ENV["ANALYTICS_ENDPOINT"] || "").to_json %>;
      </script>
      <%# Analytics page-view tracking on Turbo navigation events. %>
      <%# turbo:load fires on initial page render AND on every subsequent Turbo Drive navigation, %>
      <%# so a single handler covers both cases without double-firing. %>
      <script nonce="<%= content_security_policy_nonce %>">
        document.addEventListener("turbo:load", function () {
          var key = window.trackingKey;
          var endpoint = window.trackingEndpoint;
          if (!key || !endpoint) return;

          var page = window.location.pathname;
          var ref = document.referrer || "";

          if (typeof fetch !== "undefined") {
            fetch(endpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ key: key, event: "page_view", path: page, referrer: ref })
            }).catch(function () {
              // Network failures are benign — do not surface to the user.
            });
          }
        });
      </script>
    <% end %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>