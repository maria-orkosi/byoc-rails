<h1 class="dashboard-heading">Dashboard</h1>

<% if @components.empty? %>
  <div class="empty-state">
    <p>No components yet. Create your first one.</p>
  </div>
<% else %>
  <div class="component-grid">
    <% @components.each do |component| %>
      <%= render "dashboard/component_card", component: component %>
    <% end %>
  </div>
<% end %>