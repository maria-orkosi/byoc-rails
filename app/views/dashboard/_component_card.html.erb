<div class="component-card">
  <div class="component-card-header">
    <span class="component-name"><%= component.name %></span>
    <span class="status-dot <%= component_status_class(component) %>" title="<%= component.status || "unknown" %>"></span>
  </div>
  <div class="component-card-body">
    <span class="component-status-text"><%= component.status || "unknown" %></span>
    <% if component.last_deployed_at %>
      <span class="component-deployed">Deployed: <%= component.last_deployed_at.strftime("%b %d, %Y %H:%M") %></span>
    <% else %>
      <span class="component-deployed">Not yet deployed</span>
    <% end %>
  </div>
</div>